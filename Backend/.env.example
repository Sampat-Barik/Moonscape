# Moonscape Backend Environment Configuration
PROJECT_NAME="Moonscape Backend"
VERSION="1.0.0"
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# CORS Configuration (allows frontend development servers)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Data Paths
DEM_DATA_PATH="data/sample_dem.tif"
SITES_DATA_PATH="data/sites.json"

# Scientific Constants
LUNAR_RADIUS_METERS=1737400.0
MAX_SAFE_SLOPE_DEG=10.0
CRITICAL_SLOPE_DEG=15.0
MAX_SAFE_ROUGHNESS_M=0.5

# AI Scientific Explainer Configuration (Phase 7)
# Provider options: 'auto', 'gemini', 'openai', or 'mock'
# 'auto' selects 'gemini' if GEMINI_API_KEY is present, or falls back to 'mock'
MOONSCAPE_AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
MOONSCAPE_AI_MODEL="gemini-1.5-flash"
MOONSCAPE_AI_TIMEOUT_SECONDS=15.0
MOONSCAPE_AI_TEMPERATURE=0.2
