# Moonscape Frontend — Environment Configuration Example
# Copy this file to .env or .env.local to configure your local development environment:
#   cp .env.example .env.local

# Base URL of the FastAPI backend (FastAPI default is http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# API Connection Mode:
#   "auto" (default) - Probe GET /api/health at startup; use live backend if online, fallback to mock data
#   "live"           - Always connect to live backend (network errors displayed in UI)
#   "mock"           - Always run in deterministic offline demo mode (no network requests)
VITE_API_MODE=auto

# Per-request timeout in milliseconds (default: 10000ms / 10s)
VITE_API_TIMEOUT_MS=10000

# Default Port References:
#   Frontend dev server: http://localhost:5173
#   Backend API (FastAPI): http://127.0.0.1:8000
