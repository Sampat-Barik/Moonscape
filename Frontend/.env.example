# Moonscape Frontend — Environment Configuration Example
# Copy this file to .env or .env.local to configure your local development environment:
#   cp .env.example .env.local

# Base URL of the FastAPI backend (FastAPI default is http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# API Connection Mode:
#   "live" (recommended) - Connect to live backend (network errors displayed in UI)
#   "mock"               - Run in deterministic offline demo mode (no network requests)
#   "auto"               - Probe /api/health at startup, fallback to mock only on network outage
VITE_API_MODE=live

# Per-request timeout in milliseconds (default: 30000ms / 30s)
VITE_API_TIMEOUT_MS=30000

# Default Port References:
#   Frontend dev server: http://localhost:5173
#   Backend API (FastAPI): http://127.0.0.1:8000
